# Write your MySQL query statement below
SELECT name, population, area
FROM  World 
WHERE area >= 3000000
    OR population >= 25000000;# Write your MySQL query statement below

# Explanation:
# SELECT name, population, area
#     -> Selects the country name, population, and area.
#
# FROM World
#     -> Gets the data from the World table.
#
# WHERE area >= 3000000
#     -> Selects countries whose area is at least 3,000,000 km².
#
# OR population >= 25000000
#     -> Also selects countries whose population is at least 25,000,000.
#
# OR
#     -> Only ONE of the conditions needs to be true.
#
# Therefore, the query returns countries that have:
# 1. Area >= 3,000,000 km²
#    OR
# 2. Population >= 25,000,000
#
# Example:
# A country with area = 3,500,000 and population = 10,000,000
# will be included because its area satisfies the first condition.
#
# A country with area = 500,000 and population = 30,000,000
# will be included because its population satisfies the second condition.